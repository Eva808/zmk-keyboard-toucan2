#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_ru.h"
#include "keys_uk.h"

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <5 5>;
            then-layer = <5>;
        };
    };

    macros {
        TO_ENG: TO_ENG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LS(NUMBER_1))>, <&macro_release>;

            label = "TO_ENG";
        };

        TO_RU: TO_RU {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LS(NUMBER_2))>, <&macro_release>;

            label = "TO_RU";
        };

        TO_UKR: TO_UKR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LA(LS(N3))>, <&macro_release>;

            label = "TO_UKR";
        };

        PASS: PASS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LC(LA(Z))>, <&macro_release>;

            label = "PASS";
        };
    };

    behaviors {
        UKR_YI: UKR_YI {
            compatible = "zmk,behavior-tap-dance";
            label = "UKR_YI";
            #binding-cells = <0>;
            bindings =
                <&mt LA(UK_UKRAINIAN_I) UK_UKRAINIAN_I>,
                <&kp UK_CYRILLIC_YI>;
        };

        UKR_G: UKR_G {
            compatible = "zmk,behavior-tap-dance";
            label = "UKR_G";
            #binding-cells = <0>;
            bindings = <&kp LS(UK_CYRILLIC_GHE)>, <&kp UK_CYRILLIC_GHE_UPTURN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        eng {
            bindings = <
&kp ESC  &kp W  &kp L  &kp Y  &kp P  &kp B  &kp Z  &kp F  &kp O  &kp U  &kp DEL  &kp BSPC  &kp TAB  &mt LG(C) C  &mt LA(R) R  &mt LS(S) S  &mt LC(T) T  &kp G  &kp M  &mt RC(N) N  &mt RS(E) E  &mt RA(I) I  &mt RG(A) A  &kp EQUAL  &sl 5  &kp Q  &kp J  &kp V  &kp D  &kp K  &kp X  &kp H  &kp COMMA  &kp DOT  &kp MINUS  &none  &tog 4  &lt 0 SPACE  &kp ENTER  &kp ENTER  &kp SPACE  &tog 3
            >;
        };

        ru {
            bindings = <
&kp ESC  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE  &kp RU_CYRILLIC_U  &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE  &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE  &kp RU_CYRILLIC_HA  &kp TAB  &mt LG(RU_CYRILLIC_EF) RU_CYRILLIC_EF  &mt LA(RU_CYRILLIC_YERU) RU_CYRILLIC_YERU  &mt LS(RU_CYRILLIC_VE) RU_CYRILLIC_VE  &mt LC(RU_CYRILLIC_A) RU_CYRILLIC_A  &kp RU_CYRILLIC_PE  &kp RU_CYRILLIC_ER  &mt RC(RU_CYRILLIC_O) RU_CYRILLIC_O  &mt RS(RU_CYRILLIC_EL) RU_CYRILLIC_EL  &mt RA(RU_CYRILLIC_DE) RU_CYRILLIC_DE  &mt RG(RU_CYRILLIC_ZHE) RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E  &sl 5  &kp RU_CYRILLIC_YA  &kp RU_CYRILLIC_CHE  &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE  &kp RU_CYRILLIC_YU  &kp RU_COMMA  &kp RU_DOT  &tog 4  &lt 4 RU_SPACE  &kp ENTER  &kp ENTER  &lt 3 RU_SPACE  &tog 3
            >;
        };

        ukr {
            bindings = <
&kp ESC  &kp LS(UK_CYRILLIC_SHORT_I)  &kp UK_CYRILLIC_TSE  &kp UK_CYRILLIC_U  &kp UK_CYRILLIC_KA  &kp UK_CYRILLIC_IE  &kp UK_CYRILLIC_EN  &UKR_G  &kp UK_CYRILLIC_SHA  &kp UK_CYRILLIC_SHCHA  &kp UK_CYRILLIC_ZE  &kp UK_CYRILLIC_HA  &kp TAB  &mt LG(UK_CYRILLIC_EF) UK_CYRILLIC_EF  &UKR_YI  &mt LS(UK_CYRILLIC_VE) UK_CYRILLIC_VE  &mt LC(UK_CYRILLIC_A) UK_CYRILLIC_A  &kp UK_CYRILLIC_PE  &kp UK_CYRILLIC_ER  &mt RC(UK_CYRILLIC_O) UK_CYRILLIC_O  &mt RS(UK_CYRILLIC_EL) UK_CYRILLIC_EL  &mt RA(UK_CYRILLIC_DE) UK_CYRILLIC_DE  &mt RG(UK_CYRILLIC_ZHE) UK_CYRILLIC_ZHE  &kp LS(UK_UKRAINIAN_IE)  &sl 5  &kp UK_CYRILLIC_YA  &kp UK_CYRILLIC_CHE  &kp UK_CYRILLIC_ES  &kp UK_CYRILLIC_EM  &kp UK_CYRILLIC_I  &kp UK_CYRILLIC_TE  &kp UK_CYRILLIC_SOFT_SIGN  &kp UK_CYRILLIC_BE  &kp UK_CYRILLIC_YU  &kp UK_COMMA  &kp UK_DOT  &tog 4  &lt 4 UK_SPACE  &kp ENTER  &kp ENTER  &lt 3 UK_SPACE  &tog 3
            >;
        };

        sym {
            bindings = <
&trans  &kp LS(POUND)  &kp LS(DQT)  &kp LBKT  &kp RBKT  &kp LS(DLLR)  &kp LS(PRCNT)  &kp HOME  &kp UP  &kp END  &kp SEMI  &trans  &trans  &kp LS(AT)  &mt LA(SQT) SQT  &mt LS(LEFT_PARENTHESIS) LEFT_PARENTHESIS  &mt LC(RIGHT_PARENTHESIS) RIGHT_PARENTHESIS  &kp FSLH  &kp LS(STAR)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(COLON)  &trans  &to 0  &kp LS(EXCL)  &kp LS(QMARK)  &kp LS(LBRC)  &kp LS(RBRC)  &kp BSLH  &kp LS(CARET)  &kp LS(AMPS)  &trans  &trans  &trans  &kp UNDERSCORE  &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN
            >;
        };

        num {
            bindings = <
&trans  &none  &kp HOME  &kp UP  &kp END  &none  &kp DOT  &kp N7  &kp N8  &kp N9  &kp EQUAL  &trans  &trans  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &kp COMMA  &mt RC(N4) N4  &mt RS(N5) NUMBER_5  &mt RA(N6) NUMBER_6  &kp FSLH  &kp MINUS  &tog 0  &none  &kp LBKT  &none  &kp RBKT  &none  &kp N0  &kp N1  &kp N2  &kp N3  &kp STAR  &kp PLUS  &trans  &trans  &trans  &trans  &trans  &kp PRINTSCREEN
            >;
        };

        fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &none  &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &none  &none  &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI  &none  &tog 0  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &TO_UKR  &TO_ENG  &TO_RU  &trans  &trans  &none
            >;
        };
    };
};
